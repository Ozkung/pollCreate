# MongoDB connection string (Atlas: Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Database name (default: pollcreate)
MONGODB_DB=pollcreate
# PromptPay for the Donate button shown after voting (phone number, 13-digit ID or 15-digit e-wallet ID).
# Leave empty to hide Donate.
PROMPTPAY_ID=
# Optional: recipient name shown under the QR
PROMPTPAY_NAME=
